# IA — Cloudflare Workers AI / plano Free
# Não usa OpenAI nem Gemini. No Workers Free, a cota gratuita é limitada e,
# quando termina, novas chamadas falham em vez de gerar cobrança automática.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Formulário — Gmail SMTP
# Use uma SENHA DE APP do Google; nunca a senha normal da conta.
GMAIL_USER=inklysolutions@gmail.com
GMAIL_APP_PASSWORD=
LEAD_TO=inklysolutions@gmail.com
